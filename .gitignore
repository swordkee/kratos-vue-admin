# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/

# Go workspace file
go.work

# IDE specific files
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# Build output
bin/
dist/

# Config files with sensitive data
configs/config.local.yaml
configs/*.local.yaml

# Log files
*.log
logs/
# 例外：源码目录名恰为 logs/ 的（web/src/views/system/logs 是操作日志页，非日志输出目录）
!web/src/**/logs/

# OS specific files
.DS_Store
Thumbs.db
